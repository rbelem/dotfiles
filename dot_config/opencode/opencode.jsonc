{
  "$schema": "https://opencode.ai/config.json",
  // Budget mode (2026-10-15, revised 2026-10-21). OpenCode Go+ is the metered
  // route: every model on it carries a rolling allowance (5h = 20% of monthly,
  // weekly = 50%, monthly = 100%). Muse Spark 1.3 Contributor (data-use tier)
  // drives the main session since 2026-10-15 — on V2 hosts the MAIN session
  // model is the root `model` below, not the preset's orchestrator entry.
  // Title, compaction and summary run on the zero-quota MiniMax M3.1 Flash
  // Free. The agent team lives in the "default" preset of
  // oh-my-opencode-slim.jsonc, where each chain now puts a zero-quota model
  // and a flat-plan model (zai-coding-plan, alibaba-token-plan) ahead of the
  // paid Go models, which stay as fallbacks only.
  "model": "opencode-go/muse-spark-1.3-contributor",
  "variant": "high",
  "providers": {
    "zai": {},
    "zhipu": {},
    "minimax-coding-plan": {},
    "deepseek": {}
  },
  "experimental": {
    "disable_paste_summary": true,
    "portable_shell_scanner": true,
    "subagent_depth": 5,
    "todo": true
  },
  "watcher": {
    "ignore": [
      "node_modules",
      "dist",
      ".codegraph",
      ".next",
      "target"
    ]
  },
  "mcp": {
    "timeout": {
      "catalog": 60000,
      "execution": 60000
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "oauth": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "firecrawl-mcp": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp",
        "headers": {
          "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
        },
        "oauth": false
      },
      "browser-harness": {
        "type": "local",
        "command": [
          "browser-harness-mcp"
        ],
        "environment": {
          "PYTHONPATH": ""
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ]
      },
      "firefox-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--connectExisting",
          "--marionettePort",
          "2828"
        ]
      },
      "opencode-docs": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "opencode-docs-mcp@latest"
        ],
        "enabled": false,
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "timeout": {
          "catalog": 600000,
          "execution": 600000
        }
      },
      "open-design": {
        "type": "local",
        "command": [
          "open-design",
          "mcp",
          "--daemon-url",
          "http://127.0.0.1:7456"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 120000,
          "execution": 1800000
        }
      },
      "zvec_grep": {
        "type": "local",
        "command": [
          "zg",
          "server",
          "--stdio",
          "--mcp-toolset",
          "full"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 600000,
          "execution": 600000
        }
      },
      "wigolo": {
        "type": "remote",
        "url": "http://127.0.0.1:3333/mcp"
      },
      "jev-mcp": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@jkudish/jev-mcp"
        ],
        "environment": {
          "OPENROUTER_API_KEY": "{env:OPENROUTER_API_KEY}",
          "TYPESAFE_API_KEY": "{env:TYPESAFE_API_KEY}"
        }
      },
      "jev-review": {
        "type": "local",
        "command": [
          "jev-review"
        ],
        "environment": {
          "JEV_API_KEY": "{env:JEV_API_KEY}",
          "OPENROUTER_API_KEY": "{env:OPENROUTER_API_KEY}"
        }
      }
    },
    "cua": {
      "type": "local",
      "command": ["/home/rodrigo/.local/share/devbox/global/default/.devbox/nix/profile/default/bin/cua", "mcp"],
      "enabled": true
    }
  },
  "permissions": [
    { "resource": "*", "effect": "ask", "action": "*" },
    { "resource": "*", "effect": "allow", "action": "edit" },
    { "resource": "/*", "effect": "ask", "action": "edit" },
    { "resource": "*", "effect": "allow", "action": "glob" },
    { "resource": "*", "effect": "allow", "action": "grep" },
    { "resource": "*", "effect": "allow", "action": "list" },
    { "resource": "*", "effect": "allow", "action": "question" },
    { "resource": "*", "effect": "allow", "action": "read" },
    { "resource": "*", "effect": "allow", "action": "shell" },
    { "resource": "*", "effect": "allow", "action": "skill" },
    { "resource": "*", "effect": "allow", "action": "subagent" },
    { "resource": "*", "effect": "allow", "action": "todowrite" },
    { "resource": "*", "effect": "allow", "action": "webfetch" },
    { "resource": "*", "effect": "allow", "action": "websearch" },
    { "resource": "*", "effect": "allow", "action": "*_*" },

    { "resource": "git push *", "effect": "ask", "action": "shell" },
    { "resource": "rm *", "effect": "ask", "action": "shell" },

    { "resource": "*.env", "effect": "deny", "action": "read" },

    { "resource": "~/.agents/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.agents/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.cache/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.cargo/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.config/bifrost/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.config/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/.config/nvim/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.local/share/*", "effect": "allow", "action": "edit" },
    { "resource": "~/.local/share/*", "effect": "allow", "action": "external_directory" },
    { "resource": "/nix/*", "effect": "allow", "action": "external_directory" },
    { "resource": "/tmp/*", "effect": "allow", "action": "edit" },
    { "resource": "/tmp/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/Workspace/github.com/*", "effect": "allow", "action": "edit" },
    { "resource": "~/Workspace/github.com/*", "effect": "allow", "action": "external_directory" },
    { "resource": "~/Workspace/rbelem/*", "effect": "allow", "action": "edit" },
    { "resource": "~/Workspace/rbelem/*", "effect": "allow", "action": "external_directory" },

    // OptChat memory (optchat.memory plugin). MUST stay at the END of this
    // array: the plugin resolves policy by LAST matching rule and treats any
    // effect other than "allow" as a denial. The `{action:"*",effect:"ask"}`
    // wildcard above therefore revoked memory for every session
    // (read=false/share=false -> "Memory read permission was revoked" ->
    // MEMORY_NOT_READY -> every turn fell back to native). These two rules
    // re-grant it. Verified: policy digest flips 38572924... -> 49642803...
    { "resource": "*", "effect": "allow", "action": "optchat.read" },
    { "resource": "*", "effect": "allow", "action": "optchat.share" },
  ],
  "plugins": [
    // opencode2-cow-worktree (dogfood): installed by DIRECTORY DISCOVERY, not
    // by a `plugins` entry. Every .ts/.js under plugins/ is auto-discovered as
    // a local plugin, and plugins/opencode2-cow-worktree/index.ts is picked up
    // that way. Declaring it here as a `package` too made opencode2 load the
    // same tree twice; the package-sourced copy failed ("Plugin failed to
    // load") because the loader does not resolve the symlinked local tree.
    // The symlink makes tracked working-tree edits live, since the runtime is
    // Bun. See README "Install and configure".
    // @prevalentware/opencode-goal-plugin: DISABLED — breaks opencode2 (v2):
    // its context.command.transform calls draft.get/draft.update, removed in
    // the v2 Command Draft (only .add exists). Each die() kills the shared
    // runtime whose flush() the model.catalog bootstrap awaits → every
    // CLI/TUI command failed with "Model catalog initialization timed out".
    // ponytail: local V2 port at plugins/ponytail
    // agentmemory-capture and autolearn were retired 2026-10-16. Both engines
    //   were dead and upstreams exist. The devbox.d/agentmemory entry is gone.
    //   dcg-guard.js is upstream generated. It comes from `dcg install
    //   --opencode`, so do not edit the LIVE copy — the chezmoi source holds
    //   a one-clause LOCAL PATCH (upstream gates the v2 hook on the tool name
    //   `bash`, but the v2 shell tool is named `shell`, so the guard never
    //   ran). Run `chezmoi apply` after `dcg install --opencode` to restore
    //   the patch; scripts/probe-guards.mjs asserts it is alive.
    //   The hand-written dcg-guard.ts was deleted 2026-10-16. The generated
    //   copy loads and the local one failed.
    //   model-announcer was retired 2026-10-16. Native v2 covers it.
    // deferred (no V2 support upstream): @slkiser/opencode-quota (TUI-heavy),
    //   @tarquinen/opencode-smart-title (superseded by native title agent)
    // opencode-todolist was RETIRED 2026-10-20. opencode v2.1.0 restored the
    //   native todowrite tool behind experimental.todo (see the experimental
    //   block above) and ships its own sidebar todo (opencode.sidebar.todo),
    //   so the plugin's server tools and TUI strip are both redundant.
    //   Deltas accepted at retirement: no todoread tool (the model reads the
    //   list back from the last todowrite result), no priority field, no
    //   100-item/2000-char caps, and no per-request context injection of the
    //   list (native reads it from session message history instead).
    //   The fork checkout at ~/Workspace/github.com/rbelem/opencode-todolist
    //   is left on disk, unloaded.
    "oh-my-opencode-slim",
    // OptChat (rbelem fork of ahlner/opencode-optchat @ 1b38517, audited
    // 2026-10-20: no own network calls, no spawn, no eval; writes confined to
    // its SQLite DB + 0600 diagnostics beside it; 131/131 tests pass,
    // check:dist clean). Pinned to the full audited commit. Supports the
    // OpenCode 2.0.x and 2.1.x hosts. Explicit options
    // auto-enable memory (settings.ts line 22). Do NOT set "database" here:
    // the default path is per project, and one pinned global path would make
    // every project fight over the first scope binding. Per-project DBs land
    // under ~/.local/share/optchat/<identity>/. NOTE: object-form entries
    // resolve as npm/github packages only — a local dir path in "package"
    // loads nothing (verified 2026-10-12); the local clone at
    // ~/Workspace/github.com/rbelem/opencode-optchat is the audit reference.
    // Remove this entry to disable; originals stay until
    // `bun run admin forget <db> <session> --confirm`.
    {
      "package": "github:rbelem/opencode-optchat#1b38517bc19d2506dcc4ef8defab2e63fbce1a14",
      "options": {
        "compactorModel": { "providerID": "opencode-go", "id": "minimax-m3.1-flash-free" }
      }
    },
    // opencode-supervisor (npm, v0.1.0 by vimtor, audited 2026-10-20):
    // a second model reviews each prompt and tool call against `instructions`
    // and stops the run when the agent breaks them. Audit of dist/server.js:
    // no fetch, no spawn/exec, no eval, no file writes -- it only calls
    // ctx.generate.text on the judge model plus ctx.session.interrupt and
    // ctx.session.synthetic. Requires a V2 host (2.1.1 here).
    // NOTE: the judge receives the last 10 session messages (2k chars each)
    // and the reviewed tool input, so session content leaves the machine
    // through the judge provider (opencode-go).
    // Blocking mode: every prompt and tool call waits for the verdict, so
    // each one costs one glm-5.3 round trip. `fallback: allow` keeps a dead
    // or slow judge from bricking a session.
    //{
    //  "package": "opencode-supervisor",
    //  "options": {
    //    "model": "opencode-go/glm-5.3",
    //    "instructions": "Never run destructive git operations (git reset --hard, git clean, git push --force, git branch -D, git rebase, git checkout -- .) unless the user explicitly asked for that exact operation in the current turn. Never commit, push, or merge to main or another protected branch unless the user explicitly asked for it. Never read, print, or transmit secrets: no ~/.ssh, no ~/.aws, no auth.json or any credential file, no .env files, no keyring, Bitwarden, or Secrets Manager values. Never write, edit, or delete files outside the current workspace directory. Never run commands that destroy data outside the workspace.",
    //    "mode": "blocking",
    //    "action": "stop",
    //    "scope": ["prompts", "tools"],
    //    "ignore": ["todowrite"],
    //    "fallback": "allow"
    //  }
    //}
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "title": {
      // space-bunny-free was retired server-side (Oct 19 probe: "Model
      // unavailable"). MiniMax M3.1 Flash Free replaced it: free, unlimited
      // Go quota, 1M ctx, no training + 0-day retention.
      "model": "opencode-go/minimax-m3.1-flash-free"
    },
    "compaction": {
      //"model": "opencode-go/muse-spark-1.3-contributor"
      "model": "opencode-go/minimax-m3.1-flash-free"
    },
    "summary": {
      //"model": "opencode-go/muse-spark-1.3-contributor"
      "model": "opencode-go/minimax-m3.1-flash-free"
    },
    "autolearn-reviewer": {
      "description": "Reviews past conversations for self-improvement opportunities",
      "hidden": true,
      "steps": 20,
      "system": "Load the autolearn-reviewer skill and follow its instructions to review the attached conversation for learning opportunities. Take immediate action: record observations, update memory, create or patch skills.",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        // V1 had write:allow + edit:deny; V2 merges write/patch/edit into one
        // `edit` action, so this grants full edit (incl. file creation).
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        //{ "action": "webfetch", "resource": "*", "effect": "deny" },
        //{ "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 32768
  },
  // Relative to the project checkout, so a `cow` clone lands on the source's own
  // filesystem. opencode2's default is $XDG_DATA_HOME/worktree/<project>, which
  // is a different device here (and on most setups), and a reflink cannot cross
  // devices -- so the default breaks `cow` while `git` worktrees do not care.
  // Read by opencode2's builtin opencode.config.worktree plugin.
  "worktree": {
    "directory": ".opencode/worktrees"
  },
  "formatter": true,
  "lsp": true,
  "instructions": [
    "~/.autolearn/personas/default/memory.context.md"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
