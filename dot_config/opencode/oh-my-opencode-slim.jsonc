{
  "$schema": "https://raw.githubusercontent.com/alvinunreal/oh-my-opencode-slim/master/oh-my-opencode-slim.schema.json",
  "disabled_agents": [],
  "preset": "default",
  "presets": {
    "default": {
      "orchestrator": {
        "model": [
          { "id": "opencode-go/minimax-m3.1-flash-free", "variant": "max" },
          { "id": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
          { "id": "opencode-go/muse-spark-1.3-contributor", "variant": "high" },
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" },
          { "id": "opencode-go/mimo-v2.6-flash", "variant": "default" }
        ],
        "variant": "high"
      },
      "oracle": {
        "model": [
          { "id": "opencode-go/glm-5.3", "variant": "max" },
          { "id": "opencode-go/kimi-k3", "variant": "max" },
          { "id": "opencode-go/deepseek-v4.1-flash", "variant": "max" }
        ],
        "variant": "max"
      },
      "librarian": {
        "model": [
          { "id": "opencode-go/minimax-m3.1-flash-free", "variant": "low" },
          { "id": "opencode/glm-5.3-flash-free", "variant": "low" },
          { "id": "opencode-go/beam-free", "variant": "low" },
          { "id": "opencode-go/gpt-6-luna", "variant": "low" },
          { "id": "opencode-go/deepseek-v4.1-flash", "variant": "low" }
        ],
        "variant": "low"
      },
      "explorer": {
        "model": [
          { "id": "opencode-go/muse-spark-1.3-contributor", "variant": "low" },
          { "id": "opencode-go/minimax-m3.1-flash-free", "variant": "low" },
          { "id": "opencode/glm-5.3-flash-free", "variant": "high" },
          { "id": "opencode-go/beam-free", "variant": "high" },
          { "id": "opencode-go/mimo-v2.6-flash", "variant": "default" }
        ],
        "variant": "low"
      },
      "designer": {
        "model": [
          { "id": "opencode-go/qwen3.8-max", "variant": "xhigh" },
          { "id": "opencode-go/qwen3.8-flash", "variant": "xhigh" },
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" }
        ],
        "variant": "xhigh"
      },
      "fixer": {
        "model": [
          { "id": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
          { "id": "opencode-go/muse-spark-1.3-contributor", "variant": "high" },
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" },
          { "id": "opencode-go/muse-spark-1.2-contributor", "variant": "high" },
          { "id": "opencode-go/mimo-v2.6-flash", "variant": "default" }
        ],
        "variant": "high"
      },
      "observer": {
        "model": [
          { "id": "opencode-go/glm-5.3-flash", "variant": "high" }
        ],
        "variant": "high"
      },
      "council": {
        "model": [
          { "id": "opencode-go/glm-5.3", "variant": "max" },
          { "id": "opencode-go/mimo-v2.6-pro", "variant": "default" }
        ],
        "variant": "max"
      }
    }
  },
  "agents": {
    "fast-generic": {
      "model": [
        { "id": "opencode-go/minimax-m3.1-flash-free", "variant": "low" },
        { "id": "opencode-go/beam-free", "variant": "high" },
        { "id": "opencode/glm-5.3-flash-free", "variant": "high" },
        { "id": "opencode-go/claude-haiku-5-5", "variant": "low" },
        { "id": "opencode-go/glm-5.3-flash", "variant": "low" }
      ],
      "variant": "low",
      "prompt": "You are a fast generic execution agent for routine mechanical command work. Run requested shell commands, inspect results, and report concise outcomes. For git commits or pushes, inspect git status, git diff, and recent log first; stage only intended files; avoid secrets; preserve repository commit-message style. Never amend or rebase unless the user explicitly asked; plain force-push (--force / -f), reset --hard, clean, and branch -D are blocked by the dcg guard, while the safe --force-with-lease form is allowed. Do not edit code or make architecture/design decisions.",
      "orchestratorPrompt": "Delegate to @fast-generic for routine mechanical command work: git status/diff/log reconnaissance, normal commit preparation, creating commits, pushing commits, and no-edit command validation such as lint, typecheck, static verification, tests, builds, or package-manager equivalents. Ask it to inspect diffs before committing, stage only intended files, avoid secrets, preserve repository commit-message style, and report final commit hashes or push results. Do not use it for code edits, design work, architecture, debugging strategy, docs research, or destructive git history operations such as amend, rebase, reset --hard, clean, force-push, or deleting branches unless the user explicitly requested that exact operation.",
      "skills": [],
      "mcps": []
    },
    "investigator": {
      "model": [
        { "id": "opencode-go/glm-5.3", "variant": "high" },
        { "id": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
        { "id": "opencode-go/muse-spark-1.3-contributor", "variant": "high" },
        { "id": "opencode-go/minimax-m3.1-flash-free", "variant": "low" }
      ],
      "variant": "high",
      "prompt": "You are an evidence investigation and review agent. Gather, verify, and weigh evidence, then report findings with exact citations and honest confidence. You host pstack's why and reflect evidence roles: repository and session archaeology, transcript and thread mining, code and documentation reading, and multi-source synthesis. Use shell and MCP tools for reading, listing, diffing, and querying. Stay read-only: never edit files, write code, commit, push, or mutate state; run only non-destructive commands. Verify claims against primary sources before reporting; never invent a source or citation, and mark anything unverified as unverified. Report compactly: finding, evidence (path, URL, or command), confidence. Do not implement changes or make design decisions.",
      "orchestratorPrompt": "Delegate to @investigator for evidence-backed investigation and review: root-cause archaeology, session or transcript mining, git, ticket, and thread evidence gathering, citation verification, and multi-source synthesis with shell and MCP access. It is read-only. Prefer @explorer for quick file or symbol lookup, @librarian for external docs, and @oracle for advisory judgment or design review. Never route code edits or implementation to it.",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "codesearch": "allow",
        "ast_grep_search": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow",
        "question": "allow",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "task": "deny",
        "bash": {
          "*": "allow",
          "*git add*": "deny",
          "*git commit*": "deny",
          "*git push*": "deny",
          "*push *": "deny",
          "*git rm*": "deny",
          "*git mv*": "deny",
          "*git switch*": "deny",
          "*git restore*": "deny",
          "*git checkout*": "deny",
          "*git reset*": "deny",
          "*git clean*": "deny",
          "*git tag -d*": "deny",
          "*branch -D*": "deny",
          "rm *": "deny",
          "* rm *": "deny",
          "*rm -rf*": "deny",
          "*rm -r *": "deny",
          "mv *": "deny",
          "* mv *": "deny",
          "*sed -i*": "deny",
          "*tee *": "deny",
          "*sudo *": "deny",
          "* chmod *": "deny",
          "* chown *": "deny",
          "*npm install*": "deny",
          "*pip install*": "deny"
        }
      },
      "skills": [],
      "mcps": ["*"]
    }
  },
  "multiplexer": {
    "type": "herdr",
    "layout": "main-vertical",
    "viewer": "mini"
  },
  "council": {
    "presets": {
      "default": {
        "alpha": {
          "model": ["opencode-go/kimi-k3"],
          "variant": "max"
        },
        "beta": {
          "model": ["opencode-go/glm-5.3"],
          "variant": "max"
        },
        "gamma": {
          "model": ["opencode-go/qwen3.8-max"],
          "variant": "xhigh"
        },
        "delta": {
          "model": ["opencode-go/mimo-v2.6-pro"],
          "variant": "default"
        },
        "epsilon": {
          "model": ["opencode-go/minimax-m3.1-flash-free"],
          "variant": "max"
        }
      }
    }
  }
}
